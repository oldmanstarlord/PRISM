{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/portfolio", "destination": "/index.html" },
    { "source": "/portfolio-demo", "destination": "/index.html" },
    { "source": "/news", "destination": "/index.html" },
    { "source": "/mst", "destination": "/index.html" },
    { "source": "/companies/:symbol", "destination": "/index.html" }
  ]
}
