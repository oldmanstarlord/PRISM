# Copy to .env and replace placeholders before starting Compose.
PRISM_ENVIRONMENT=production
PRISM_LOCAL_AUTH_ENABLED=false
PRISM_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Optional direct/session-pooler connection for migrations.
PRISM_MIGRATION_DATABASE_URL=
PRISM_SUPABASE_URL=https://PROJECT_REF.supabase.co
PRISM_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Set your actual HTTPS origin for public deployment. Same-origin requests work locally.
PRISM_CORS_ORIGINS=["https://prism.example.com"]
PRISM_TRUSTED_HOSTS=["localhost","127.0.0.1","prism.example.com"]
PRISM_FIRECRAWL_API_KEY=
PRISM_HTTP_PORT=8080
