PRISM_ENVIRONMENT=development
PRISM_FIRECRAWL_API_KEY=
PRISM_NEWS_MAX_ARTICLES=8
PRISM_NEWS_DAILY_CREDIT_BUDGET=50
PRISM_NEWS_REFRESH_MINUTES=60
PRISM_NEWS_AUTO_REFRESH=true
PRISM_NEWS_SOURCES=["economictimes.indiatimes.com","moneycontrol.com","livemint.com","business-standard.com","reuters.com"]
PRISM_NEWS_QUERY=India NSE stock market company earnings financial news
PRISM_NEWS_RSS_URLS=[]
PRISM_API_HOST=0.0.0.0
PRISM_API_PORT=8000
PRISM_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
PRISM_MIGRATION_DATABASE_URL=
PRISM_CORS_ORIGINS=["http://localhost:5173"]
PRISM_TRUSTED_HOSTS=["localhost","127.0.0.1"]
PRISM_MAX_REQUEST_BYTES=1048576
PRISM_REQUEST_TIMEOUT_SECONDS=60
PRISM_EXPENSIVE_RATE_LIMIT_REQUESTS=20
PRISM_EXPENSIVE_RATE_LIMIT_WINDOW_SECONDS=60
PRISM_SUPABASE_URL=https://PROJECT_REF.supabase.co
PRISM_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
POSTGRES_DB=prism
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism
